{
  "name": "a11y-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:api": "node tests/reports-api.mjs",
    "test:ui": "node tests/portal-ui.mjs",
    "test:submissions": "node --experimental-strip-types tests/submissions.mts",
    "test:submissions:ui": "node tests/submissions-ui.mjs",
    "test:scans": "node --experimental-strip-types tests/scans.mts",
    "test:scans:browser": "node --experimental-strip-types tests/scans-browser.mts",
    "test:scans:worker": "node --experimental-strip-types tests/scan-worker.mts",
    "test:scans:ui": "node tests/scans-ui.mjs",
    "scan:worker": "node --experimental-strip-types scripts/scan-worker.mts",
    "comparison:worker": "node --experimental-strip-types scripts/comparison-worker.mts",
    "test:comparisons": "node --experimental-strip-types tests/comparisons.mts",
    "test:comparisons:browser": "node --experimental-strip-types tests/comparisons-browser.mts",
    "test:comparisons:ui": "node tests/comparisons-ui.mjs",
    "test:comparisons:worker": "node --experimental-strip-types tests/comparison-worker.mts",
    "test:cms": "node --experimental-strip-types tests/cms-api.mts",
    "test:db": "node --experimental-strip-types tests/cms-db.mts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "evaluate": "node --experimental-strip-types scripts/evaluate.mts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3"
  }
}
