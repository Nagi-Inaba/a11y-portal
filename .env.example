# Supabase project: Connect panel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# sample: 架空の1件で画面開発（CMSは利用不可） / supabase: DB接続・CMS利用
# 未設定時は supabase。DB障害時にsampleへ切り替わることはありません。
REPORTS_DATA_SOURCE=sample

# 公開時に設定する運営者名・非公開で相談できる問い合わせ先（ページに表示されます）
SITE_OPERATOR_NAME=稲葉凪
PRIVACY_CONTACT_EMAIL=
# メールアドレスの代わりに、非公開で受け付けるHTTPSの問い合わせフォームを指定できます
PRIVACY_CONTACT_URL=
